# Changes to KappaTools for this benchmark:
# - rename the identifier `effect`, a keyword since OCaml 5.3, to `effect_`;
# - read results in JSON array form only (yojson 3 no longer has variants);
# - build KaSim as bytecode as well.
diff --git a/core/cflow/utilities.ml b/core/cflow/utilities.ml
index 86c3799..dc2df6c 100644
--- a/core/cflow/utilities.ml
+++ b/core/cflow/utilities.ml
@@ -247,7 +247,7 @@ let make_unambiguous parameters ?(shall_we_compute = we_shall)
   ) else
     error, profiling_info, trace
 
-let lift_to_care_about_ambiguities f requirement effect parameters
+let lift_to_care_about_ambiguities f requirement effect_ parameters
     ?(shall_we_compute = we_shall)
     ?(shall_we_compute_profiling_information = we_shall)
     ?(print_if_zero = we_shall) kappa_handler profiling_info error trace =
@@ -275,7 +275,7 @@ let lift_to_care_about_ambiguities f requirement effect parameters
         parameters ~shall_we_compute ~shall_we_compute_profiling_information
         ~print_if_zero kappa_handler profiling_info error trace
     in
-    let trace = set_ambiguity_level trace (handle_ambiguities effect true) in
+    let trace = set_ambiguity_level trace (handle_ambiguities effect_ true) in
     error, log_info, trace
   ) else
     error, profiling_info, trace
